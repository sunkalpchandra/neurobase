# PostgreSQL connection string. Local Homebrew Postgres 15 works with the default below.
DATABASE_URL=postgres://localhost:5432/neurobase

# Used by integration tests (vitest). Must be a separate database.
TEST_DATABASE_URL=postgres://localhost:5432/neurobase_test

# Optional: embeddings provider for semantic search. When unset, search runs in
# lexical-only mode (PostgreSQL full-text search) and the UI says so.
# Supported: "openai" (requires OPENAI_API_KEY). Leave empty to disable.
EMBEDDINGS_PROVIDER=
OPENAI_API_KEY=

# Optional: contact email sent in User-Agent headers to public APIs
# (ClinicalTrials.gov, PubMed E-utilities, Crossref polite pool).
INGEST_CONTACT_EMAIL=

# Optional: NCBI API key raises the PubMed E-utilities rate limit from 3 to 10 req/s.
NCBI_API_KEY=
